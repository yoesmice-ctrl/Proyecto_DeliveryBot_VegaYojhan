    {
      "parameters": {
        "jsCode": "// Obtener todos los ítems de la pestaña MENU\nconst items = $input.all();\n\nlet textoMenu = \"☕ *MENÚ DIGITAL DELIVERYBOT* 🥟\\n\\n\";\n\n// Agrupar productos por categoría limpia\nconst categorias = {};\n\nitems.forEach(item => {\n  const json = item.json;\n\n  // .trim() elimina los espacios extra al inicio y final\n  const cat = json.categoria ? json.categoria.trim().toUpperCase() : 'GENERAL';\n  const id = json.id_producto || 'N/A';\n  const nombre = (json.nombre || 'Producto').trim();\n  const precio = json.precio ? Number(json.precio).toLocaleString('es-CO') : '0';\n\n  if (!categorias[cat]) {\n    categorias[cat] = [];\n  }\n\n  categorias[cat].push(`• *ID ${id}*: ${nombre} - *$${precio}*`);\n});\n\n// Construir el texto organizado por secciones unificadas\nfor (const [nombreCat, listaProductos] of Object.entries(categorias)) {\n  textoMenu += `📌 *${nombreCat}*\\n`;\n  textoMenu += listaProductos.join('\\n  __\\n') + '\\n  __\\n\\n';\n}\n\n// Pie del mensaje\ntextoMenu += \"👉 _Para agregar productos al carrito, responde con el ID y la cantidad (Ejemplo: 1 2 para pedir 2 Café americano)._\";\n\nreturn [\n  {\n    json: {\n      menu_formateado: textoMenu\n    }\n  }\n];"
      },
