    {
      "parameters": {
        "jsCode": "// Captura el texto enviado por el usuario (ej: \"1 2\")\nconst telegramData = $('Telegram Trigger').first().json;\nconst texto = (telegramData.message?.text || telegramData.callback_query?.data || \"\").trim();\nconst telegramId = telegramData.message?.chat.id || telegramData.callback_query?.message.chat.id;\n\n// Extraer ID de producto y Cantidad\nconst partes = texto.split(/\\s+/);\nconst idProducto = partes[0];\nconst cantidad = parseInt(partes[1]) || 1;\n\nreturn [{\n  json: {\n    telegram_id: String(telegramId),\n    id_producto: idProducto,\n    cantidad: cantidad,\n    pantalla_actual: \"SELECCIONANDO_PRODUCTO\",\n    ultimo_cambio: new Date().toISOString()\n  }\n}];"
      },
