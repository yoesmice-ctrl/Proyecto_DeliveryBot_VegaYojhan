        "jsCode": "const pedidos = $input.all();\n\nif (pedidos.length === 0) {\n  return [{ json: { text: \"📋 No tienes pedidos registrados todavía.\" } }];\n}\n\nlet mensaje = \"📋 <b>TUS PEDIDOS</b> 📋\\n\\n\";\n\npedidos.forEach(p => {\n  const d = p.json;\n  mensaje += `🧾 <b>${d.id_pedido}</b>\\n`;\n  mensaje += `Estado: ${d.estado}\\n`;\n  mensaje += `Total: $${d.total_pago}\\n`;\n  mensaje += `Fecha: ${d.fecha} ${d.hora}\\n\\n`;\n});\n\nreturn [{ json: { text: mensaje } }];"
      },
