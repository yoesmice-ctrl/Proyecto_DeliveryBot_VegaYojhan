    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst telegramData = $('Telegram Trigger').first().json;\nconst chatId = telegramData.message.chat.id;\n\nif (items.length === 0) {\n  return [{ json: { carrito_vacio: true, chat_id: chatId, mensaje: \"Tu carrito esta vacio. Agrega productos antes de confirmar (ej: 5 1).\" } }];\n}\n\nlet total = 0;\nlet detalle = [];\nitems.forEach(i => {\n  const d = i.json;\n  const subtotal = Number(d.subtotal) || 0;\n  total += subtotal;\n  detalle.push(`${d.nombre_producto} x${d.cantidad} ($${subtotal.toLocaleString('es-CO')})`);\n});\n\nreturn [{\n  json: {\n    carrito_vacio: false,\n    chat_id: chatId,\n    detalles_pedido: detalle.join(', '),\n    total_pago: total\n  }\n}];"
      },
