    {
      "parameters": {
        "jsCode": "const productoSheet = $input.first().json;\nconst datosPedido = $('Code in JavaScript1').first().json;\n\nconst id = datosPedido.id_producto;\nconst cantidad = datosPedido.cantidad;\n\n// Guard: el producto no existe en MENU\nif (!productoSheet || !productoSheet.nombre) {\n  return [{\n    json: {\n      no_encontrado: true,\n      chat_id: datosPedido.chat_id,\n      mensaje_confirmacion: `⚠️ No encontré el producto con ID <b>${id}</b>. Revisa el menú (escribe <b>1</b>) y envía un ID válido con la cantidad (ej: 5 1).`\n    }\n  }];\n}\n\nconst nombreProducto = productoSheet.nombre;\nconst rawPrecio = String(productoSheet.precio || '0').replace(/[^0-9]/g, '');\nconst precioUnitario = parseFloat(rawPrecio) || 0;\nconst subtotal = precioUnitario * cantidad;\n\nconst mensajeRespuesta = `🛒 <b>Agregado al carrito!</b>\\n\\n` +\n  `• <b>Producto:</b> ${nombreProducto}\\n` +\n  `• <b>Cantidad:</b> ${cantidad}\\n` +\n  `• <b>Subtotal:</b> $${subtotal.toLocaleString('es-CO')}\\n\\n` +\n  `Escribe otro ID y cantidad para seguir agregando (ej: 5 1), <b>2</b> para ver tu carrito, o <b>confirmar</b> para hacer el pedido.`;\n\nreturn [{\n  json: {\n    no_encontrado: false,\n    chat_id: datosPedido.chat_id,\n    id_producto: id,\n    nombre_producto: nombreProducto,\n    cantidad: cantidad,\n    precio_unitario: precioUnitario,\n    subtotal: subtotal,\n    fecha_agregado: new Date().toISOString(),\n    mensaje_confirmacion: mensajeRespuesta\n  }\n}];"
      },
