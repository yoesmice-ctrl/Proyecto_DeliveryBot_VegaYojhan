      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [{ json: { text: \"🛒 Tu carrito esta vacio. Envia el ID del producto y la cantidad (ej: 5 1) para agregar algo.\" } }];\n}\n\nlet total = 0;\nlet mensaje = \"🛒 <b>TU CARRITO</b>\\n\\n\";\n\nitems.forEach(i => {\n  const d = i.json;\n  const subtotal = Number(d.subtotal) || 0;\n  mensaje += `• ${d.nombre_producto} x${d.cantidad} - $${subtotal.toLocaleString('es-CO')}\\n`;\n  total += subtotal;\n});\n\nmensaje += `\\n<b>Total: $${total.toLocaleString('es-CO')}</b>\\n\\nEscribe <b>confirmar</b> para hacer el pedido, o sigue agregando productos (ej: 5 1).`;\n\nreturn [{ json: { text: mensaje } }];"
      },
