      "parameters": {
        "jsCode": "// 1 punto por cada $5.00 gastados en el pedido confirmado\nconst datosPedido = $('Code - Armar Pedido Final').first().json;\nconst telegramTrigger = $('Telegram Trigger').first().json;\n\nconst total = datosPedido.total_pago || 0;\nconst puntosGanados = Math.floor(total / 5);\n\nreturn [{\n  json: {\n    telegram_id: String(telegramTrigger.message.from.id),\n    chat_id: datosPedido.chat_id,\n    subtotal: total,\n    puntos_ganados: puntosGanados\n  }\n}];"
      },
