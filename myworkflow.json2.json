      "parameters": {
        "jsCode": "let mensajeMenu = \"👋 <b>¡Hola! Bienvenido a nuestra tienda.</b>\\n\\n📋 <b>MENÚ DISPONIBLE</b> 📋\\n\\n\";\n\nconst items = $input.all();\n\nitems.forEach(item => {\n  const p = item.json;\n  mensajeMenu += `<b>ID:</b> ${p.id_producto}\\n`;\n  mensajeMenu += `☕ <b>${p.nombre}</b>\\n`;\n  // resto del código..."
      },
